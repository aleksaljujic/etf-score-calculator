# Azure OpenAI (required for screenshot reading). Use a vision-capable model deployment.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: only set for models that accept it (reasoning models don't).
# AZURE_OPENAI_TEMPERATURE=0

# Rate limiting (recommended). Upstash Redis from the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_REQUESTS=5
RATE_LIMIT_WINDOW_SECONDS=600

# Limits
MAX_IMAGES=8
MAX_IMAGE_BYTES=2500000
MAX_TOTAL_BYTES=3200000
MODEL_TIMEOUT_MS=55000
MAX_OUTPUT_TOKENS=8000
