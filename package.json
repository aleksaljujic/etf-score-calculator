{
  "name": "etf-score-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "ETF Belgrade master admission ranking score calculator",
  "scripts": {
    "build": "node scripts/copy-tesseract.mjs && esbuild src/app.ts --bundle --minify --format=iife --target=es2020 --outfile=public/app.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "ocr:check": "tsx scripts/ocr-check.ts",
    "dev": "npm run build && npx serve public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tesseract.js-data/srp": "^1.0.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
